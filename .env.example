# The current local-extractive mode does not load this file or call an LLM.
# Paths are reserved configuration for a later application interface.
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# app.py reads this process environment setting (it does not load this file).
# A clean checkout automatically downloads only the two pinned official reports.
# Set false to require local data or the per-session upload fallback instead.
FIC_AUTO_LOAD_REPORTS=true

# Leave these empty until a provider, model, and cost budget are approved.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
